export default async function handler(req, res) {
  const { q, ciudad } = req.query;

  // Simulación de resultados reales
  const trabajos = [
    { empresa: "OXXO", puesto: "Cajero/a", ciudad: "San Nicolas de los Garza", link: "https://www.occ.com.mx/empleo/cajero-oxxo-12345" },
    { empresa: "Bachoco", puesto: "Operador de Producción", ciudad: "San Nicolas de los Garza", link: "https://www.occ.com.mx/empleo/operador-produccion-67890" },
    { empresa: "Cemex", puesto: "Técnico en Mantenimiento", ciudad: "Monterrey", link: "https://www.occ.com.mx/empleo/tecnico-mantenimiento-11223" },
  ];

  let resultados = trabajos.filter(t =>
    t.puesto.toLowerCase().includes(q?.toLowerCase() || "") &&
    t.ciudad.toLowerCase().includes(ciudad?.toLowerCase() || "")
  );

  res.status(200).json(resultados);
}

