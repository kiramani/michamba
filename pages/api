const empleos = [
  {
    puesto: "Técnico electromecánico",
    empresa: "Maquila Norte",
    ubicacion: "San Nicolás",
    sueldo: 12000
  },
  {
    puesto: "Auxiliar de mantenimiento",
    empresa: "Industria MX",
    ubicacion: "Apodaca",
    sueldo: 10000
  },
  {
    puesto: "Operador de producción",
    empresa: "Plásticos SA",
    ubicacion: "Escobedo",
    sueldo: 9000
  }
];

document.getElementById("btnBuscar").addEventListener("click", buscar);

function buscar() {
  const texto = document.getElementById("busqueda").value.toLowerCase();
  const resultados = empleos.filter(e =>
    e.puesto.toLowerCase().includes(texto) ||
    e.ubicacion.toLowerCase().includes(texto)
  );

  mostrar(resultados);
}

function mostrar(lista) {
  const div = document.getElementById("resultados");
  div.innerHTML = "";

  if (lista.length === 0) {
    div.innerHTML = "<p>No se encontraron empleos</p>";
    return;
  }

  lista.forEach(e => {
    div.innerHTML += `
      <div class="card">
        <h3>${e.puesto}</h3>
        <p><strong>Empresa:</strong> ${e.empresa}</p>
        <p><strong>Ubicación:</strong> ${e.ubicacion}</p>
        <p><strong>Sueldo:</strong> $${e.sueldo}</p>
      </div>
    `;
  });
}
